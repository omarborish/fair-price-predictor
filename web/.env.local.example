# Fair Price Used Car Predictor - Frontend Environment Variables
# ==============================================================
# Copy this file to .env.local and update values

# ===================
# API Configuration
# ===================
# Development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (uncomment and update when deploying)
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ===================
# Google AdSense (optional - add after approval)
# ===================
# Get your publisher ID from adsense.google.com
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# ===================
# Google Analytics (optional)
# ===================
# Get your measurement ID from analytics.google.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===================
# Site Configuration
# ===================
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ===================
# Supabase (for Community & Feedback features)
# ===================
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===================
# Umami Analytics (privacy-friendly)
# ===================
# Get these from your Umami dashboard (cloud.umami.is or self-hosted)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# UMAMI_API_URL=https://cloud.umami.is
# UMAMI_API_KEY=your-api-key

# ===================
# Admin Moderation
# ===================
# Secret key to access admin features at /admin (hide/delete comments)
# Generate a strong random string: openssl rand -base64 32
ADMIN_SECRET_KEY=your-secret-key-here
