# Fair Price Used Car Predictor - Environment Variables
# =====================================================
# Copy this file to .env and update values for your environment

# ===================
# Backend (FastAPI)
# ===================
# Environment: "development" or "production"
ENVIRONMENT=development

# Frontend URL for CORS (required in production)
# FRONTEND_URL=https://your-domain.com

# ===================
# Frontend (Next.js)
# ===================
# API URL - set in web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================
# Google AdSense (optional - add after approval)
# ===================
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# ===================
# Google Analytics (optional)
# ===================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===================
# Production Deployment Notes
# ===================
# 1. Set ENVIRONMENT=production on your backend server
# 2. Set FRONTEND_URL to your actual frontend domain
# 3. Enable HTTPS on both frontend and backend
# 4. Use proper secrets management (Railway/Vercel env vars)
